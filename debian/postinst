#!/bin/sh
set -e

# 安装/升级后，把 GXDE Display Manager (gxdm) 登录界面预选的会话设为
# gxde-wlcom：麒麟 9000c 设备装完本包后，重启/下次登录界面即默认走
# /usr/bin/startgxde_wlcom_9000c 的 hisi 硬件加速会话。
#
# gxdm 在 /var/lib/gxdm/state.conf 的 [Last] Session= 中保存预选会话，
# 这里只替换 Session，保留 [Last] User 与 [Greeter] 等原有配置。
# 用户之后在登录界面手动选择其他会话时，gxdm 仍会按用户选择更新。

GXDM_STATE=/var/lib/gxdm/state.conf
GXDM_SESSION=/usr/share/wayland-sessions/gxde-wlcom.desktop

set_gxdm_default_session() {
    if [ ! -f "$GXDM_STATE" ]; then
        # gxdm 已安装但还没写入过 state.conf：直接创建一个最小配置。
        umask 022
        printf '[Last]\nSession=%s\n' "$GXDM_SESSION" > "$GXDM_STATE"
        return
    fi

    tmp=$(mktemp /tmp/gxdm-state.XXXXXX)
    trap 'rm -f "$tmp"' HUP INT QUIT TERM EXIT

    awk -v session="$GXDM_SESSION" '
        BEGIN { section = ""; seen_last = 0; replaced = 0 }
        /^[[:space:]]*\[[^]]*\][[:space:]]*$/ {
            if (section == "[Last]" && !replaced)
                print "Session=" session
            section = $0
            sub(/^[[:space:]]+/, "", section)
            sub(/[[:space:]]+$/, "", section)
            if (section == "[Last]")
                seen_last = 1
            print $0
            next
        }
        section == "[Last]" && $0 ~ /^[[:space:]]*Session[[:space:]]*=/ {
            print "Session=" session
            replaced = 1
            next
        }
        { print }
        END {
            if (section == "[Last]" && !replaced)
                print "Session=" session
            if (!seen_last) {
                if (NR > 0)
                    printf "\n"
                print "[Last]"
                print "Session=" session
            }
        }
    ' "$GXDM_STATE" > "$tmp"

    chmod 0644 "$tmp"
    cat "$tmp" > "$GXDM_STATE"
    trap - HUP INT QUIT TERM EXIT
    rm -f "$tmp"
}

case "$1" in
    configure)
        # 仅在 gxdm 与 gxde-wlcom 会话文件都已安装时配置。
        if [ -x /usr/bin/gxdm ] && [ -f "$GXDM_SESSION" ]; then
            set_gxdm_default_session
        fi
    ;;
esac

exit 0
