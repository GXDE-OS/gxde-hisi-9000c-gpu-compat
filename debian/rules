#!/usr/bin/make -f

%:
	dh $@

# 编译 LD_PRELOAD 兼容 shim（eglGetPlatformDisplay / gbm_* / 修正 wl_surface_interface）
override_dh_auto_build:
	gcc -O2 -shared -fPIC \
	    -o src/usr/lib/gxde-hisi-9000c-gpu-compat/libhisi_gbm_shim.so \
	    src/usr/lib/gxde-hisi-9000c-gpu-compat/hisi_gbm_shim.c -ldl

# 重新构建前清理生成的 .so，避免陈旧产物
override_dh_clean:
	rm -f src/usr/lib/gxde-hisi-9000c-gpu-compat/libhisi_gbm_shim.so
	dh_clean

# 按需求将启动劫持脚本直接装入 /usr/local/bin（dh_usrlocal 只支持整目录树，
# 不支持 /usr/local/bin 下的单个文件，故跳过；文件由 dpkg 直接管理）
override_dh_usrlocal:
	@true

override_dh_shlibdeps:
	dh_shlibdeps --exclude=libwayland-client.so.0.21.0 \
		--exclude=libhisi_gbm_shim.so \
		--exclude=libwayland-cursor.so.0.21.0 
